@EndUserText.label: 'Access control - Literal'
@MappingRole: true
define role ZAC_01_LOG_C460 {
    grant
        select
            on
                zcds_29_log_c460
                    where
                        CountryCode = 'US';
                        
    grant select on zcds_30_log_c460
     where Status = 'N';
                        
}