@EndUserText.label: 'Access control - Aspect PFCG'
@MappingRole: true
define role ZAC_04_LOG_C460 {
    grant 
        select
            on
                ZCDS_32_LOG_C460
                    where
                        (CarrierId) = aspect pfcg_auth(zaocarr460, zafcarr460, ACTVT = '03');
                        
}